CREATE PROCEDURE usp_CalculateAllStoreConversion
AS
BEGIN
    SELECT 
        s.name_store AS магазин,
        COUNT(p.order_number) AS заказов,
        s.views AS просмотров,
        (COUNT(p.order_number) * 100.0) / NULLIF(s.views, 0) AS конверсия_процент
    FROM online_store s
    LEFT JOIN product_order p ON s.name_store = p.name_store
    GROUP BY s.name_store, s.views
    ORDER BY конверсия_процент DESC;
END;
GO


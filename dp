        behavior_id INT IDENTITY(1,1) PRIMARY KEY,
        client_id INT FOREIGN KEY REFERENCES client(client_id),
        product_id INT FOREIGN KEY REFERENCES product(product_id),
        behavior_type VARCHAR(20) NOT NULL, -- 'VIEW', 'CART_ADD'
        created_at DATETIME DEFAULT GETDATE()
    );
    
    -- Добавляем демо-данные для эмуляции
    INSERT INTO customer_behavior (client_id, product_id, behavior_type)
    SELECT TOP 50 client_id, 1, 'VIEW' FROM client ORDER BY NEWID();

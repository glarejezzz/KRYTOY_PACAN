CREATE PROCEDURE usp_AnalyzeAllWarrantyClaims
AS
BEGIN
    SELECT 
        firm AS производитель,
        SUM(units_sold) AS продано,
        SUM(warranty_claims) AS брак,
        (SUM(warranty_claims) * 100) / SUM(units_sold) AS процент_брака
    FROM product
    WHERE units_sold > 0
    GROUP BY firm;
END;
GO

